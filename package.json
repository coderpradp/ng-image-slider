{
  "name": "@coderpradp/ng-image-slider",
  "version": "20.0.0",
  "description": "Angular Image slider with lightbox. An Angular responsive image slider with lightbox popup. Also support youtube url, image base64 string and mp4 video urls and base64 string.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4100 --host 0.0.0.0",
    "build": "ng build ng-image-slider --watch --configuration production",
    "build:prod": "ng build ng-image-slider --configuration production",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular-devkit/schematics": "~20.3.32",
    "@angular/animations": "~20.3.26",
    "@angular/common": "~20.3.26",
    "@angular/compiler": "~20.3.26",
    "@angular/core": "~20.3.26",
    "@angular/forms": "~20.3.26",
    "@angular/platform-browser": "~20.3.26",
    "@angular/platform-browser-dynamic": "~20.3.26",
    "@angular/router": "~20.3.26",
    "core-js": "~3.4.5",
    "rxjs": "~6.5.3",
    "tslib": "~2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.32",
    "@angular-devkit/core": "~20.3.32",
    "@angular/cli": "~20.3.32",
    "@angular/compiler-cli": "~20.3.26",
    "@angular/language-service": "~20.3.26",
    "@types/node": "^24.13.3",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "ng-packagr": "~20.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
